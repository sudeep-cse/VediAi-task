# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/ai_assessment

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- AI provider ----
# One of: mock | anthropic | openai
# "mock" requires NO API key and lets you run the whole pipeline end-to-end.
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Cache ----
CACHE_TTL_SECONDS=86400

# ---- Worker ----
WORKER_CONCURRENCY=3

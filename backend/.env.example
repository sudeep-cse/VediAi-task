# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/ai_assessment

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- AI provider ----
# One of: mock | anthropic | openai
# "mock" requires NO API key and lets you run the whole pipeline end-to-end.
AI_PROVIDER=mock

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Cache ----
CACHE_TTL_SECONDS=86400

# ---- Worker ----
WORKER_CONCURRENCY=3
